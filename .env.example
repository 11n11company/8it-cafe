# Database Connection Settings (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafe_cloud_pos
DB_USER=cafe_admin
DB_PASSWORD=cafe_secure_dev_pass_2026

# Optional: Full Database Connection URL (overrides DB_* settings if provided)
# DATABASE_URL=postgresql://cafe_admin:cafe_secure_dev_pass_2026@localhost:5432/cafe_cloud_pos

# Database Connection Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

# Application Server Settings
NODE_ENV=development
PORT=5000

# CORS Allowed Origin (single URL or comma-separated list; wildcard '*' is strictly forbidden in production)
CORS_ORIGIN=http://localhost:5173

# Authentication & Security Settings (Phase 3.2)
# JWT Secret Key (required in production; minimum 32 characters in production)
JWT_SECRET=dev_jwt_secret_cafe_cloud_pos_super_secure_32chars
# JWT Access Token Expiry (e.g., 15m, 1h, 8h, 7d; default is 8h for retail POS cashier shift)
JWT_EXPIRES_IN=8h
# Password Hashing Rounds (bcrypt cost factor: 10 to 16, default 12)
BCRYPT_SALT_ROUNDS=12
# Login Rate Limiting (window in ms and max attempts per IP)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
