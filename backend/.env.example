# ==============================================================================
# Cafe Cloud POS - Backend Environment Configuration Template
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# CORS Allowed Origin (single origin or comma-separated list; wildcard '*' forbidden in production)
CORS_ORIGIN=http://localhost:5173

# Database Connection Settings (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cafe_cloud_pos
DB_USER=cafe_admin
DB_PASSWORD=cafe_secure_dev_pass_2026

# Optional: Full Database Connection URL (overrides DB_* settings if provided)
# DATABASE_URL=postgresql://cafe_admin:cafe_secure_dev_pass_2026@localhost:5432/cafe_cloud_pos

# Database Connection Pool Settings
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000

