{
  "name": "cafe-cloud-pos",
  "version": "0.1.0",
  "description": "Cafe Cloud POS - Multi-brand cloud POS for Cafe Company and Brownie Shop",
  "private": true,
  "scripts": {
    "db:up": "node database/migrate.js up",
    "db:down": "node database/migrate.js down",
    "db:status": "node database/migrate.js status",
    "db:seed": "node database/seed.js",
    "db:verify": "node database/verify.js",
    "docker:up": "docker compose -f deployment/docker-compose.yml up -d",
    "docker:down": "docker compose -f deployment/docker-compose.yml down",
    "backend:dev": "node --watch backend/src/server.js",
    "backend:start": "node backend/src/server.js",
    "backend:test": "node --test backend/tests/health.test.js backend/tests/auth.test.js backend/tests/auth.integration.test.js backend/tests/phase3_3.integration.test.js backend/tests/phase3_4.integration.test.js",
    "test": "npm run backend:test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
